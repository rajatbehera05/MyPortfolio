# EmailJS Configuration for Portfolio Contact Form
# Obtain these values from your EmailJS dashboard: https://dashboard.emailjs.com/

# 1. Email Service ID (Email Services tab -> e.g., service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here

# 2. Email Template ID (Email Templates tab -> e.g., template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# 3. Public Key / User ID (Account -> General -> Public Key)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
